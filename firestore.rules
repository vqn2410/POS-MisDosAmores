rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos y Categorías (Lectura pública, Escritura autenticada)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ventas y Tickets
    match /sales/{saleId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // Comprobantes fiscales emitidos y reportes importados desde ARCA
    match /creditNotes/{creditNoteId} {
      allow read, write: if request.auth != null;
    }

    match /arcaReportVouchers/{voucherId} {
      allow read, write: if request.auth != null;
    }

    // Clientes y Proveedores
    match /customers/{customerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    match /suppliers/{supplierId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Registros de Auditoría e Inventario Kardex
    match /kardex_movements/{movementId} {
      allow read, create: if request.auth != null;
    }

    match /audit_logs/{logId} {
      allow read, create: if request.auth != null;
    }

    // Empresa y Sucursales
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Usuarios (solo lectura/escritura autenticada)
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
