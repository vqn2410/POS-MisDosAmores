# ARCA (ex AFIP) - Configuración del facturador electrónico
# Copiá este archivo a .env.arca.local y completá los valores reales.
# .env.arca.local ya está excluido de Git (*.local en .gitignore).

# CUIT del comercio emisor
ARCA_CUIT=

# testing (homologación) | production
ARCA_ENVIRONMENT=testing

# Punto de venta configurado en ARCA
ARCA_SALES_POINT=1

# Ruta a los certificados emitidos por ARCA (NO versionar estos archivos)
# homologación:  server/arca/certs/comercio.crt
# producción:    server/arca/certs/comercio_prod.crt (obtenido en AFIP con el mismo CSR)
ARCA_CERTIFICATE_PATH=server/arca/certs/comercio.crt
ARCA_PRIVATE_KEY_PATH=server/arca/certs/comercio.key

# Passphrase de la clave privada (si la tiene)
ARCA_PRIVATE_KEY_PASSPHRASE=

# Datos del emisor (se muestran en el ticket / se validan contra ARCA)
ARCA_EMITTER_NAME=
ARCA_EMITTER_ADDRESS=
# IVA_SUJETO_EXENTO | IVA_RESPONSABLE_INSCRIPTO | MONOTRIBUTO | etc.
ARCA_EMITTER_TAX_CONDITION=
